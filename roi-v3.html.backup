    // ==========================================
    // INITIALIZATION
    // ==========================================
    document.addEventListener('DOMContentLoaded', function() {
      initializeTasks();
      initializeAssumptions();
      updateCalculations();
    });

    // ==========================================
    // TAB MANAGEMENT
    // ==========================================
    function switchTab(tabName, event) {
      // Hide all tabs
      document.querySelectorAll('.tab-content').forEach(tab => {
        tab.classList.remove('active');
      });

      // Remove active class from all buttons
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active');
      });

      // Show selected tab
      document.getElementById('tab-' + tabName).classList.add('active');

      // Highlight active button
      if (event && event.target) {
        event.target.classList.add('active');
      } else {
        // Find button by tab name and activate it
        const buttons = document.querySelectorAll('.tab-btn');
        buttons.forEach((btn, index) => {
          const tabs = ['inputs', 'tasks', 'assumptions', 'results', 'comparison', 'timeline', 'charts'];
          if (tabs[index] === tabName) {
            btn.classList.add('active');
          }
        });
      }

      // If switching to charts, update them
      if (tabName === 'charts') {
        setTimeout(updateCharts, 100);
      }
    }

    // ==========================================
    // SCENARIO MANAGEMENT
    // ==========================================
    function setScenario(scenario) {
      currentScenario = scenario;

      // Update button states
      document.querySelectorAll('.scenario-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      event.target.closest('.scenario-btn').classList.add('active');

      // Apply scenario assumptions
      const assumptions = SCENARIOS[scenario];
      Object.keys(assumptions).forEach(key => {
        const elem = document.getElementById('assumption_' + key);
        if (elem) {
          elem.value = assumptions[key] * 100;
          updateRangeValue(elem, 'value_' + key);
        }
      });

      updateCalculations();
    }

    // ==========================================
    // TASK BREAKDOWN
    // ==========================================
    function initializeTasks() {
      const tbody = document.getElementById('taskTableBody');
      let html = '';

      Object.keys(TASK_CATEGORIES).forEach(category => {
        html += `
          <tr class="task-category">
            <td colspan="6"><strong>${category}</strong></td>
          </tr>
        `;

        const tasks = TASK_CATEGORIES[category];
        tasks.forEach((task, index) => {
          const taskId = category.replace(/\s+/g, '_') + '_' + index;
          const annualHours = task.freq * task.hours;
          const automation = Math.round(task.automation * 100);
          const hoursSaved = Math.round(annualHours * task.automation);

          html += `
            <tr data-task-id="${taskId}">
              <td>${task.name}</td>
              <td><input type="number" class="task-freq" value="${task.freq}" min="0" max="500" style="width: 70px;" onchange="recalculateTask(this)"></td>
              <td><input type="number" class="task-hours" value="${task.hours}" min="0" max="200" step="0.5" style="width: 70px;" onchange="recalculateTask(this)"></td>
              <td class="task-annual">${annualHours}</td>
              <td><input type="range" class="task-automation" value="${automation}" min="0" max="100" onchange="recalculateTask(this)" style="width: 100px;"> <span class="automation-percent">${automation}%</span></td>
              <td class="task-saved" style="font-weight: 600; color: var(--success);">${hoursSaved}</td>
            </tr>
          `;
        });

        // Category subtotal
        const categoryTotal = tasks.reduce((sum, t) => sum + (t.freq * t.hours), 0);
        const categorySaved = tasks.reduce((sum, t) => sum + (t.freq * t.hours * t.automation), 0);

        html += `
          <tr class="task-subtotal">
            <td><strong>${category} - Subtotal</strong></td>
            <td></td>
            <td></td>
            <td><strong class="category-total">${Math.round(categoryTotal)}</strong></td>
            <td></td>
            <td><strong class="category-saved">${Math.round(categorySaved)}</strong></td>
          </tr>
        `;
      });

      // Grand total
      const grandTotal = Object.values(TASK_CATEGORIES).flat().reduce((sum, t) => sum + (t.freq * t.hours), 0);
      const grandSaved = Object.values(TASK_CATEGORIES).flat().reduce((sum, t) => sum + (t.freq * t.hours * t.automation), 0);

      html += `
        <tr class="task-total">
          <td><strong>TOTAL ANNUAL HOURS</strong></td>
          <td></td>
          <td></td>
          <td><strong id="grandTotalHours">${Math.round(grandTotal)}</strong></td>
          <td></td>
          <td><strong id="grandSavedHours">${Math.round(grandSaved)}</strong></td>
        </tr>
      `;

      tbody.innerHTML = html;
    }

    function recalculateTask(elem) {
      const row = elem.closest('tr');
      const freq = parseFloat(row.querySelector('.task-freq').value) || 0;
      const hours = parseFloat(row.querySelector('.task-hours').value) || 0;
      const automation = parseFloat(row.querySelector('.task-automation').value) / 100;

      const annual = freq * hours;
      const saved = Math.round(annual * automation);

      row.querySelector('.task-annual').textContent = Math.round(annual);
      row.querySelector('.task-saved').textContent = saved;
      row.querySelector('.automation-percent').textContent = Math.round(automation * 100) + '%';

      updateTaskTotals();
      updateCalculations();
    }

    function updateTaskTotals() {
      let grandTotal = 0;
      let grandSaved = 0;

      document.querySelectorAll('#taskTableBody tr[data-task-id]').forEach(row => {
        const annual = parseFloat(row.querySelector('.task-annual').textContent) || 0;
        const saved = parseFloat(row.querySelector('.task-saved').textContent) || 0;
        grandTotal += annual;
        grandSaved += saved;
      });

      document.getElementById('grandTotalHours').textContent = Math.round(grandTotal);
      document.getElementById('grandSavedHours').textContent = Math.round(grandSaved);
    }

    // ==========================================
    // ASSUMPTIONS PANEL
    // ==========================================
    function initializeAssumptions() {
      const container = document.getElementById('assumptionsGrid');
      const assumptions = SCENARIOS[currentScenario];

      const labels = {
        automationPercent: 'Ops Automation Percentage',
        deploymentSpeedUp: 'Deployment Speed Multiplier',
        incidentReduction: 'Incident Reduction %',
        downtimeReduction: 'Downtime Reduction %',
        timeToMarketImprovement: 'Time-to-Market Improvement %'
      };

      let html = '';
      Object.keys(assumptions).forEach(key => {
        const value = assumptions[key];
        const isPercent = key !== 'deploymentSpeedUp';
        const displayValue = isPercent ? Math.round(value * 100) : value;
        const maxValue = isPercent ? 100 : 20;

        html += `
          <div class="assumption-item">
            <div class="assumption-label">${labels[key]}</div>
            <div class="assumption-control">
              <input type="range" id="assumption_${key}" class="form-range" value="${displayValue}" min="0" max="${maxValue}"
                oninput="updateRangeValue(this, 'value_${key}'); updateCalculations()" style="flex: 1;">
              <span id="value_${key}" class="range-value">${displayValue}${isPercent ? '%' : 'x'}</span>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    function resetAssumptions() {
      setScenario(currentScenario);
    }

    // ==========================================
    // MAIN CALCULATION ENGINE
    // ==========================================
    function updateCalculations() {
      showLoading();

      setTimeout(() => {
        try {
          console.log('Starting calculations...');

          // Get all inputs
          const inputs = getInputValues();
          console.log('Inputs:', inputs);

          // Calculate current state costs
          const currentCosts = calculateCurrentCosts(inputs);
          console.log('Current costs:', currentCosts);

          // Calculate Stacktic costs
          const stackticCosts = calculateStackticCosts(inputs);
          console.log('Stacktic costs:', stackticCosts);

          // Calculate savings
          const savings = calculateSavings(currentCosts, stackticCosts, inputs);
          console.log('Savings:', savings);

          // Calculate ROI
          const roi = calculateROI(savings, stackticCosts);
          console.log('ROI:', roi);

          // Update all displays
          updateResultsDisplay(roi, savings, currentCosts, stackticCosts);
          updateComparisonTable(currentCosts, stackticCosts, savings);
          updateTimeline(roi, savings, stackticCosts);

          console.log('Calculations complete!');
          hideLoading();

        } catch (error) {
          console.error('Error in updateCalculations:', error);
          alert('Calculation error: ' + error.message + '\n\nCheck browser console for details.');
          hideLoading();
        }
      }, 500);
    }

    function getInputValues() {
      const companySize = document.getElementById('companySize').value;

      // Auto-calculate downtime and incident costs based on company size (industry benchmarks)
      const downtimeCostMap = { startup: 1000, small: 5000, medium: 15000, large: 50000, enterprise: 100000 };
      const incidentCostMap = { startup: 10000, small: 25000, medium: 50000, large: 150000, enterprise: 300000 };

      return {
        companySize: companySize,
        numStacks: parseInt(document.getElementById('numStacks').value),
        teamSize: parseInt(document.getElementById('teamSize').value),
        engineerCost: parseInt(document.getElementById('engineerCost').value),
        numDatabases: parseInt(document.getElementById('numDatabases')?.value) || 0,
        managedPercent: (parseInt(document.getElementById('managedPercent')?.value) || 100) / 100,
        downtimeCost: downtimeCostMap[companySize] || 15000,
        incidentCost: incidentCostMap[companySize] || 50000,
        opsTimePercent: parseInt(document.getElementById('opsTimePercent').value) / 100,
        deploymentsPerMonth: parseInt(document.getElementById('deploymentsPerMonth').value),
        deploymentHours: parseInt(document.getElementById('deploymentHours').value),
        securityIncidents: parseInt(document.getElementById('securityIncidents').value),
        downtimeHours: parseInt(document.getElementById('downtimeHours').value),
        failedDeployments: parseInt(document.getElementById('failedDeployments').value),
        cloudAgnosticRisk: parseInt(document.getElementById('cloudAgnosticRisk')?.value) || 200000,
        legacyHours: parseInt(document.getElementById('legacyHours')?.value) || 200,
        failedMigrations: parseInt(document.getElementById('failedMigrations')?.value) || 4,

        // Assumptions
        automationPercent: (parseFloat(document.getElementById('assumption_automationPercent')?.value) || 60) / 100,
        deploymentSpeedUp: parseFloat(document.getElementById('assumption_deploymentSpeedUp')?.value) || 5,
        incidentReduction: (parseFloat(document.getElementById('assumption_incidentReduction')?.value) || 60) / 100,
        downtimeReduction: (parseFloat(document.getElementById('assumption_downtimeReduction')?.value) || 50) / 100,
        timeToMarketImprovement: (parseFloat(document.getElementById('assumption_timeToMarketImprovement')?.value) || 50) / 100
      };
    }

    /**
     * Calculate current state costs (baseline/before Stacktic)
     *
     * This function calculates the total annual cost of your current DevOps/Platform operations
     * across multiple cost categories: labor, infrastructure, and business risk.
     *
     * METHODOLOGY:
     * 1. Labor Costs - Direct engineering time spent on ops vs feature development
     *    - Ops Labor: team_size × avg_salary × % time spent on ops work
     *    - Deployment Labor: deployments_per_month × hours_per_deployment × hourly_rate
     *    - Incident Response: security_incidents_per_year × 40 hours_avg × hourly_rate
     *
     * 2. Vendor Lock-In Infrastructure Costs
     *    - Direct annual spend on managed services (RDS, Aurora, MSK, ElastiCache, DocumentDB, etc.)
     *    - User provides their actual cloud bill for these services
     *
     * 3. Business Risk Costs
     *    - Downtime Cost: downtime_hours × cost_per_hour (revenue loss, SLA penalties)
     *    - Security Incident Cost: incidents × avg_cost_per_incident (remediation, reputation damage)
     *
     * @param {Object} inputs - User input values from the form
     * @returns {Object} Cost breakdown object with the following properties:
     *   - opsLaborCost: Annual cost of ops/devops engineering time
     *   - deploymentLaborCost: Annual cost of deployment activities
     *   - incidentResponseCost: Annual cost of incident response work
     *   - databaseCost: Annual spend on vendor-locked managed services
     *   - downtimeBusinessCost: Annual business cost from downtime
     *   - securityIncidentCost: Annual cost of security incidents
     *   - totalAnnual: Sum of all costs above
     *
     * ASSUMPTIONS:
     * - 2080 working hours per year (40 hrs/week × 52 weeks)
     * - 40 hours average time per security incident (industry standard)
     * - Downtime and incident costs vary by company size (see cost maps)
     */
    function calculateCurrentCosts(inputs) {
      // Convert annual salary to hourly rate
      // 2080 = 40 hours/week × 52 weeks/year
      const hourlyRate = inputs.engineerCost / 2080;

      // ==========================================
      // LABOR COSTS
      // ==========================================

      // Ops/DevOps Labor Cost
      // Calculate: How much does the team spend annually on ops work vs feature development?
      // Formula: team_size × avg_annual_salary × % time_on_ops
      // Example: 25 engineers × $150,000/year × 60% = $2,250,000/year
      const opsLaborCost = inputs.teamSize * inputs.engineerCost * inputs.opsTimePercent;

      // Deployment Labor Cost
      // Calculate: How much time is spent deploying applications monthly?
      // Formula: deployments/month × 12 months × hours/deployment × hourly_rate
      // Example: 20 deployments/month × 12 × 160 hours × $72/hr = $2,764,800/year
      const deploymentLaborCost = inputs.deploymentsPerMonth * 12 * inputs.deploymentHours * hourlyRate;

      // Incident Response Cost
      // Calculate: Engineering time spent on security incidents
      // Formula: incidents/year × 40 hours_avg × hourly_rate
      // Industry standard: 40 hours average per security incident (detection + response + remediation)
      // Example: 12 incidents/year × 40 hours × $72/hr = $34,560/year
      const incidentResponseCost = inputs.securityIncidents * 40 * hourlyRate;

      // ==========================================
      // INFRASTRUCTURE COSTS
      // ==========================================

      // Managed Services / Vendor Lock-In Cost
      // This is the user's direct annual cloud bill for vendor-locked managed services:
      // - AWS: RDS, Aurora, MSK, ElastiCache, DocumentDB, DynamoDB, etc.
      // - GCP: Cloud SQL, Cloud Spanner, Memorystore, etc.
      // - Azure: Azure SQL, CosmosDB, Azure Cache for Redis, etc.
      //
      // The user provides their actual annual spend on these services from their cloud bill.
      // Stacktic calculates savings by moving to cloud-agnostic K8s-native solutions:
      // - CloudNative-PG instead of RDS/Cloud SQL
      // - Strimzi/Kafka instead of MSK/Event Hubs
      // - Redis Operator instead of ElastiCache/Memorystore
      //
      // Typical savings: 60-80% cost reduction moving from managed to K8s-native
      const databaseCost = inputs.numDatabases; // Direct annual spend from user

      // ==========================================
      // BUSINESS RISK COSTS
      // ==========================================

      // Downtime Business Cost
      // Calculate: Revenue loss and SLA penalties from service downtime
      // Formula: downtime_hours/year × cost_per_hour
      // Cost per hour varies by company size (see downtimeCostMap in getInputValues)
      // Example: 24 hours downtime × $15,000/hour = $360,000/year
      const downtimeBusinessCost = inputs.downtimeHours * inputs.downtimeCost;

      // Security Incident Business Cost
      // Calculate: Total cost impact of security breaches
      // Includes: Remediation, forensics, legal, regulatory fines, reputation damage, customer churn
      // Formula: incidents/year × avg_cost_per_incident
      // Cost per incident varies by company size (see incidentCostMap in getInputValues)
      // Example: 12 incidents × $50,000 = $600,000/year
      const securityIncidentCost = inputs.securityIncidents * inputs.incidentCost;

      // ==========================================
      // TOTAL ANNUAL COST (CURRENT STATE)
      // ==========================================
      const totalAnnual = opsLaborCost + deploymentLaborCost + incidentResponseCost +
                          databaseCost + downtimeBusinessCost + securityIncidentCost;

      return {
        opsLaborCost,
        deploymentLaborCost,
        incidentResponseCost,
        databaseCost,
        downtimeBusinessCost,
        securityIncidentCost,
        totalAnnual
      };
    }

    function calculateStackticCosts(inputs) {
      const override = parseInt(document.getElementById('stackticCostOverride')?.value) || 0;

      if (override > 0) {
        const support = override * (parseInt(document.getElementById('supportPercent')?.value) || 15) / 100;
        const impl = parseInt(document.getElementById('implementationCost')?.value) || 0;
        return {
          platformCost: override,
          supportCost: support,
          implementationCost: impl,
          annualCost: override + support,
          total3Year: (override + support) * 3 + impl
        };
      }

      // Calculate based on model
      const pricingModel = document.getElementById('pricingModel')?.value || 'per-user';
      let platformCost = 0;

      if (pricingModel === 'per-stack') {
        const pricePerStack = inputs.companySize === 'enterprise' ? 5000 :
                             inputs.companySize === 'large' ? 4000 :
                             inputs.companySize === 'medium' ? 3000 : 2500;
        platformCost = inputs.numStacks * pricePerStack;

        // Volume discount
        if (inputs.numStacks >= 20) platformCost *= 0.70;
        else if (inputs.numStacks >= 10) platformCost *= 0.80;
        else if (inputs.numStacks >= 5) platformCost *= 0.90;

      } else if (pricingModel === 'per-user') {
        const pricePerUser = inputs.companySize === 'enterprise' ? 150 :
                            inputs.companySize === 'large' ? 120 :
                            inputs.companySize === 'medium' ? 100 : 80;
        platformCost = inputs.teamSize * pricePerUser * 12;

      } else { // enterprise
        platformCost = inputs.companySize === 'enterprise' ? 200000 :
                      inputs.companySize === 'large' ? 150000 :
                      inputs.companySize === 'medium' ? 100000 : 75000;
      }

      const supportPercent = (parseInt(document.getElementById('supportPercent')?.value) || 15) / 100;
      const supportCost = platformCost * supportPercent;
      const implCost = parseInt(document.getElementById('implementationCost')?.value) || (platformCost * 0.3);

      return {
        platformCost: Math.round(platformCost),
        supportCost: Math.round(supportCost),
        implementationCost: Math.round(implCost),
        annualCost: Math.round(platformCost + supportCost),
        total3Year: Math.round((platformCost + supportCost) * 3 + implCost)
      };
    }

    /**
     * Calculate annual savings from adopting Stacktic
     *
     * This function calculates the cost savings across three primary categories:
     * 1. Labor Efficiency - Reduced engineering time via automation
     * 2. Infrastructure Cost Reduction - Cloud-agnostic vendor lock-in avoidance
     * 3. Risk Mitigation - Reduced downtime and security incidents
     *
     * METHODOLOGY BY CATEGORY:
     *
     * 1. LABOR SAVINGS:
     *    A) Ops/DevOps Automation
     *       - Formula: current_ops_labor_cost × automation_percentage
     *       - Example: $2,250,000 × 75% = $1,687,500/year saved
     *       - Rationale: Stacktic automates 60-90% of repetitive ops tasks
     *
     *    B) Deployment Speed-Up
     *       - Formula: current_deployment_cost × (1 - 1/speed_multiplier)
     *       - Example: $2,764,800 × (1 - 1/8) = $2,419,200/year saved
     *       - Rationale: Deployments are 5-12x faster with Stacktic automation
     *
     *    C) Incident Response Reduction
     *       - Formula: current_incident_cost × incident_reduction_%
     *       - Example: $34,560 × 75% = $25,920/year saved
     *       - Rationale: Automated security policies prevent 60-85% of incidents
     *
     * 2. INFRASTRUCTURE SAVINGS (Vendor Lock-In Avoidance):
     *    - Formula: managed_services_cost × % cost_reduction_moving_to_k8s
     *    - Example: $500,000/year × 70% = $350,000/year saved
     *    - Rationale: Cloud-agnostic K8s solutions (CloudNative-PG, Strimzi, etc.)
     *      cost 60-80% less than vendor-locked managed services (RDS, MSK, etc.)
     *
     *    REAL-WORLD COST COMPARISON:
     *    AWS RDS db.r5.2xlarge:  ~$7,000/month = $84,000/year
     *    CloudNative-PG on EKS: ~$1,500/month = $18,000/year
     *    Savings:                                $66,000/year (78% reduction)
     *
     *    AWS MSK m5.large:       ~$4,200/month = $50,400/year
     *    Strimzi Kafka on EKS:  ~$1,200/month = $14,400/year
     *    Savings:                                $36,000/year (71% reduction)
     *
     * 3. RISK MITIGATION SAVINGS:
     *    A) Downtime Reduction
     *       - Formula: current_downtime_cost × downtime_reduction_%
     *       - Example: $360,000 × 50% = $180,000/year saved
     *       - Rationale: Automated monitoring, GitOps, self-healing reduce downtime 50-80%
     *
     *    B) Security Incident Prevention
     *       - Formula: current_security_cost × incident_reduction_%
     *       - Example: $600,000 × 75% = $450,000/year saved
     *       - Rationale: Policy-as-code, automated scanning prevent 60-85% of incidents
     *
     * @param {Object} currentCosts - Current state costs from calculateCurrentCosts()
     * @param {Object} stackticCosts - Stacktic platform costs from calculateStackticCosts()
     * @param {Object} inputs - User input values (assumptions, config)
     * @returns {Object} Savings breakdown:
     *   - opsLaborSavings: Annual ops automation savings
     *   - deploymentSavings: Annual deployment efficiency savings
     *   - incidentResponseSavings: Annual incident response savings
     *   - databaseSavings: Annual vendor lock-in avoidance savings
     *   - downtimeSavings: Annual downtime reduction value
     *   - securitySavings: Annual security incident prevention value
     *   - totalAnnualSavings: Sum of all savings above
     *
     * IMPORTANT NOTES:
     * - Savings are ANNUAL (per year)
     * - All calculations use conservative industry benchmarks
     * - Users can adjust assumptions to match their specific context
     * - Savings compound over time as automation maturity increases
     */
    function calculateSavings(currentCosts, stackticCosts, inputs) {
      // ==========================================
      // LABOR EFFICIENCY SAVINGS
      // ==========================================

      // Ops/DevOps Automation Savings
      // How much of current ops labor can be automated by Stacktic?
      // Conservative: 60%, Realistic: 75%, Aggressive: 90%
      const opsLaborSavings = currentCosts.opsLaborCost * inputs.automationPercent;

      // Deployment Speed-Up Savings
      // How much faster are deployments with Stacktic automation?
      // Conservative: 5x, Realistic: 8x, Aggressive: 12x
      // Formula: savings = current_cost × (1 - 1/multiplier)
      // Example: 8x faster = save 87.5% of deployment time
      const deploymentSavings = currentCosts.deploymentLaborCost * (1 - 1/inputs.deploymentSpeedUp);

      // Incident Response Reduction Savings
      // How many security incidents can be prevented via automation?
      // Conservative: 60%, Realistic: 75%, Aggressive: 85%
      const incidentResponseSavings = currentCosts.incidentResponseCost * inputs.incidentReduction;

      // ==========================================
      // INFRASTRUCTURE COST SAVINGS (VENDOR LOCK-IN AVOIDANCE)
      // ==========================================

      // Cloud-Agnostic Managed Services Savings
      // How much can you save by moving from vendor-locked managed services to K8s-native?
      //
      // STACKTIC APPROACH:
      // Instead of AWS RDS/Aurora, MSK, ElastiCache, DocumentDB, etc.:
      // Use cloud-agnostic K8s operators:
      // - CloudNative-PG (PostgreSQL operator)
      // - Strimzi (Kafka operator)
      // - Redis Operator
      // - MongoDB Community Operator
      //
      // COST SAVINGS BREAKDOWN:
      // 1. No vendor markup (AWS charges 3-5x for managed services)
      // 2. No vendor lock-in premium
      // 3. Multi-cloud portability (avoid exit costs)
      // 4. Use same compute already in K8s cluster (better utilization)
      //
      // Typical savings: 60-80% cost reduction
      // User provides:
      //   A) Their actual annual managed services bill
      //   B) Expected % reduction moving to K8s (default 70%)
      const databaseSavings = currentCosts.databaseCost * inputs.managedPercent;

      // ==========================================
      // BUSINESS RISK MITIGATION SAVINGS
      // ==========================================

      // Downtime Reduction Value
      // How much downtime can be avoided via automation?
      // Mechanisms:
      // - Automated monitoring & alerting (catch issues earlier)
      // - GitOps rollback (instant revert on failures)
      // - Self-healing (auto-restart failed pods)
      // - Canary deployments (catch issues before full rollout)
      // Conservative: 50%, Realistic: 65%, Aggressive: 80%
      const downtimeSavings = currentCosts.downtimeBusinessCost * inputs.downtimeReduction;

      // Security Incident Prevention Value
      // How many security incidents can be prevented?
      // Mechanisms:
      // - Policy-as-code (OPA) prevents misconfigurations
      // - Automated security scanning (SAST, DAST, container scanning)
      // - Network policies (micro-segmentation)
      // - Secret rotation automation
      // - RBAC enforcement
      // Conservative: 60%, Realistic: 75%, Aggressive: 85%
      const securitySavings = currentCosts.securityIncidentCost * inputs.incidentReduction;

      // ==========================================
      // TOTAL ANNUAL SAVINGS
      // ==========================================
      const totalAnnualSavings = opsLaborSavings + deploymentSavings + incidentResponseSavings +
                                 databaseSavings + downtimeSavings + securitySavings;

      return {
        opsLaborSavings,
        deploymentSavings,
        incidentResponseSavings,
        databaseSavings,
        downtimeSavings,
        securitySavings,
        totalAnnualSavings
      };
    }

    /**
     * Calculate ROI metrics over 3-year period
     *
     * This function calculates the return on investment (ROI) for adopting Stacktic
     * over a 3-year time horizon, including:
     * - Year-over-year net savings
     * - Payback period (months to break even)
     * - Total 3-year ROI percentage
     *
     * METHODOLOGY:
     *
     * 1. YEAR-BY-YEAR NET SAVINGS:
     *    Year 1: total_annual_savings - annual_cost - implementation_cost
     *    Year 2: total_annual_savings - annual_cost
     *    Year 3: total_annual_savings - annual_cost
     *
     *    NOTE: Year 1 includes one-time implementation cost
     *
     * 2. PAYBACK PERIOD:
     *    How many months until initial investment is recovered?
     *    Formula: (annual_cost + implementation_cost) ÷ monthly_net_savings
     *    Example: ($200K + $60K) ÷ $50K/month = 5.2 months
     *
     *    Industry Benchmarks:
     *    - Excellent: < 6 months
     *    - Good: 6-12 months
     *    - Acceptable: 12-18 months
     *    - Long: > 18 months
     *
     * 3. ROI PERCENTAGE:
     *    Formula: (total_3year_net_savings ÷ total_3year_cost) × 100
     *    Example: $3M net savings ÷ $660K total cost = 455% ROI
     *
     *    Industry Benchmarks for Platform/DevOps Tools:
     *    - Excellent: > 400%
     *    - Good: 200-400%
     *    - Acceptable: 100-200%
     *    - Poor: < 100%
     *
     * @param {Object} savings - Annual savings from calculateSavings()
     * @param {Object} stackticCosts - Stacktic platform costs
     * @returns {Object} ROI metrics:
     *   - year1NetSavings: Net savings in Year 1 (includes implementation cost)
     *   - year2NetSavings: Net savings in Year 2
     *   - year3NetSavings: Net savings in Year 3
     *   - total3YearROI: Total net savings over 3 years
     *   - paybackMonths: Months to break even (recover initial investment)
     *   - roiPercentage: 3-year ROI as a percentage
     *
     * ASSUMPTIONS:
     * - Consistent annual savings (no degradation)
     * - Annual licensing/support costs remain constant
     * - Implementation is one-time cost in Year 1
     * - No additional costs or savings beyond those calculated
     */
    function calculateROI(savings, stackticCosts) {
      // ==========================================
      // YEAR-BY-YEAR NET SAVINGS
      // ==========================================

      // Year 1 Net Savings
      // Includes one-time implementation cost
      // Example: $2M savings - $140K annual - $42K implementation = $1,818,000
      const year1NetSavings = savings.totalAnnualSavings -
                              stackticCosts.annualCost -
                              stackticCosts.implementationCost;

      // Year 2 Net Savings
      // No implementation cost (already paid in Year 1)
      // Example: $2M savings - $140K annual = $1,860,000
      const year2NetSavings = savings.totalAnnualSavings - stackticCosts.annualCost;

      // Year 3 Net Savings
      // Same as Year 2 (consistent annual costs)
      // Example: $2M savings - $140K annual = $1,860,000
      const year3NetSavings = savings.totalAnnualSavings - stackticCosts.annualCost;

      // ==========================================
      // TOTAL 3-YEAR ROI
      // ==========================================
      // Sum of all net savings over 3 years
      // Example: $1,818K + $1,860K + $1,860K = $5,538,000
      const total3YearROI = year1NetSavings + year2NetSavings + year3NetSavings;

      // ==========================================
      // PAYBACK PERIOD (MONTHS)
      // ==========================================
      // How many months to recover initial investment?
      // Initial investment = Year 1 costs (annual + implementation)
      // Monthly net benefit = (annual savings - annual cost) ÷ 12
      //
      // Formula: initial_investment ÷ monthly_net_benefit
      // Example: ($140K + $42K) ÷ ($155K/month) = 1.2 months
      //
      // NOTE: If monthly net savings is ≤ 0, payback is never (set to 999 months)
      const monthlyNetSavings = (savings.totalAnnualSavings - stackticCosts.annualCost) / 12;
      const paybackMonths = monthlyNetSavings > 0 ?
        Math.ceil((stackticCosts.annualCost + stackticCosts.implementationCost) / monthlyNetSavings) :
        999;

      // ==========================================
      // ROI PERCENTAGE
      // ==========================================
      // What percentage return on investment over 3 years?
      // Formula: (total_net_savings ÷ total_investment) × 100
      // Example: $5,538K ÷ $462K = 1,198% ROI
      //
      // NOTE: If total 3-year cost is 0, ROI is 0% (edge case)
      const roiPercentage = stackticCosts.total3Year > 0 ?
        Math.round((total3YearROI / stackticCosts.total3Year) * 100) :
        0;

      return {
        year1NetSavings,
        year2NetSavings,
        year3NetSavings,
        total3YearROI,
        paybackMonths,
        roiPercentage
      };
    }

    // ==========================================
    // UI UPDATES
    // ==========================================
    function safeUpdate(id, value) {
      const elem = document.getElementById(id);
      if (elem) {
        elem.textContent = value;
      } else {
        console.warn('Element not found:', id);
      }
    }

    function updateResultsDisplay(roi, savings, currentCosts, stackticCosts) {
      // Hero section
      safeUpdate('totalROI', formatCurrency(roi.total3YearROI));
      safeUpdate('roiSubtitle', `${roi.roiPercentage}% return over 3 years`);
      safeUpdate('paybackMonths', roi.paybackMonths);
      safeUpdate('roiPercentage', roi.roiPercentage + '%');
      safeUpdate('annualSavings', formatCurrency(roi.year1NetSavings));

      // Metrics
      safeUpdate('totalSavings', formatCurrency(savings.totalAnnualSavings * 3));
      const savingsPercent = Math.round((savings.totalAnnualSavings / currentCosts.totalAnnual) * 100);
      safeUpdate('savingsPercent', savingsPercent + '%');

      const totalHoursSaved = parseInt(document.getElementById('grandSavedHours')?.textContent) || 0;
      safeUpdate('hoursReclaimed', formatNumber(totalHoursSaved));
      const fte = (totalHoursSaved / 2080).toFixed(1);
      safeUpdate('fte', fte + ' FTE');

      const inputs = getInputValues();
      safeUpdate('speedImprovement', inputs.deploymentSpeedUp + 'x');
      safeUpdate('timeToMarket', Math.round(inputs.timeToMarketImprovement * 100) + '%');

      const riskValue = savings.downtimeSavings + savings.securitySavings;
      safeUpdate('riskValue', formatCurrency(riskValue));
      safeUpdate('incidentReduction', Math.round(inputs.incidentReduction * 100) + '%');

      // Breakdown totals
      safeUpdate('laborSavingsTotal', formatCurrency(
        savings.opsLaborSavings + savings.deploymentSavings + savings.incidentResponseSavings
      ));
      safeUpdate('devopsSavings', formatCurrency(savings.opsLaborSavings));
      safeUpdate('deploymentSavings', formatCurrency(savings.deploymentSavings));
      safeUpdate('incidentResponseSavings', formatCurrency(savings.incidentResponseSavings));
      safeUpdate('testingSavings', formatCurrency(0));

      safeUpdate('infraSavingsTotal', formatCurrency(savings.databaseSavings));
      safeUpdate('cloudSavings', formatCurrency(savings.databaseSavings * 0.7));
      safeUpdate('vendorLockSavings', formatCurrency(savings.databaseSavings * 0.2));
      safeUpdate('licenseSavings', formatCurrency(savings.databaseSavings * 0.1));

      safeUpdate('riskSavingsTotal', formatCurrency(riskValue));
      safeUpdate('downtimeSavings', formatCurrency(savings.downtimeSavings));
      safeUpdate('securitySavings', formatCurrency(savings.securitySavings));
      safeUpdate('complianceSavings', formatCurrency(0));

      safeUpdate('stackticTCOTotal', '-' + formatCurrency(stackticCosts.annualCost));
      safeUpdate('platformCost', formatCurrency(stackticCosts.platformCost));
      safeUpdate('implCost', formatCurrency(stackticCosts.implementationCost));
      safeUpdate('supportCost', formatCurrency(stackticCosts.supportCost));

      // Insights
      safeUpdate('productivityHours', formatNumber(totalHoursSaved));

      // ENTERPRISE CENTRALIZATION VALUE
      const numStacks = inputs.numStacks || 5;

      // Centralized Observability: Save 80% vs per-app monitoring setup
      // Each app needs Grafana/Prometheus setup: ~$15K/year per app in tools + labor
      const perAppMonitoringCost = 15000;
      const centralizedObservabilitySavings = (numStacks * perAppMonitoringCost) * 0.80;

      // Centralized Security: Save 70% vs fragmented policies
      // Security overhead per app: ~$20K/year (compliance, audits, policy management)
      const perAppSecurityCost = 20000;
      const centralizedSecuritySavings = (numStacks * perAppSecurityCost) * 0.70;

      // Cloud-Agnostic/Multi-Cloud: Avoid vendor lock-in premium
      // Moving databases from managed services to K8s enables cloud portability
      // 30% of current managed database costs represents the flexibility value
      const cloudAgnosticSavings = currentCosts.databaseCost * 0.30;

      // Developer Portal (Backstage): Save onboarding time & knowledge sharing
      // Average onboarding cost: 3 months * $12K/month = $36K per engineer
      // Portal reduces by 60%
      const avgOnboardingPerYear = (inputs.teamSize * 0.15) * 36000; // 15% turnover
      const developerPortalSavings = avgOnboardingPerYear * 0.60;

      // Cross-Stack Automation: Manual coordination overhead
      // Enterprise coordination tax: ~10% of engineering time
      const crossStackSavings = (inputs.teamSize * inputs.engineerCost) * 0.10;

      // Centralized AI/RAG: vs per-team AI subscriptions
      // Per-team AI spend: $500/dev/month for ChatGPT/Copilot/etc.
      // Centralized saves 50%
      const perTeamAISpend = inputs.teamSize * 500 * 12;
      const centralizedAISavings = perTeamAISpend * 0.50;

      const totalEnterpriseCentralization = centralizedObservabilitySavings +
                                           centralizedSecuritySavings +
                                           cloudAgnosticSavings +
                                           developerPortalSavings +
                                           crossStackSavings +
                                           centralizedAISavings;

      safeUpdate('enterpriseCentralizationTotal', formatCurrency(totalEnterpriseCentralization));
      safeUpdate('enterpriseCentralizationMetric', formatCurrency(totalEnterpriseCentralization));
      safeUpdate('centralizedObservabilitySavings', formatCurrency(centralizedObservabilitySavings));
      safeUpdate('centralizedSecuritySavings', formatCurrency(centralizedSecuritySavings));
      safeUpdate('cloudAgnosticSavings', formatCurrency(cloudAgnosticSavings));
      safeUpdate('developerPortalSavings', formatCurrency(developerPortalSavings));
      safeUpdate('crossStackSavings', formatCurrency(crossStackSavings));
      safeUpdate('centralizedAISavings', formatCurrency(centralizedAISavings));
    }

    function updateComparisonTable(currentCosts, stackticCosts, savings) {
      const tbody = document.getElementById('comparisonTableBody');
      if (!tbody) {
        console.warn('comparisonTableBody not found');
        return;
      }

      const categories = [
        {
          name: 'Ops/DevOps/SRE Labor',
          current: currentCosts.opsLaborCost,
          withStacktic: currentCosts.opsLaborCost - savings.opsLaborSavings,
          savings: savings.opsLaborSavings
        },
        {
          name: 'Deployment Operations',
          current: currentCosts.deploymentLaborCost,
          withStacktic: currentCosts.deploymentLaborCost - savings.deploymentSavings,
          savings: savings.deploymentSavings
        },
        {
          name: 'Incident Response',
          current: currentCosts.incidentResponseCost,
          withStacktic: currentCosts.incidentResponseCost - savings.incidentResponseSavings,
          savings: savings.incidentResponseSavings
        },
        {
          name: 'Database Infrastructure (Managed Services → K8s)',
          current: currentCosts.databaseCost,
          withStacktic: currentCosts.databaseCost - savings.databaseSavings,
          savings: savings.databaseSavings
        },
        {
          name: 'Downtime Costs',
          current: currentCosts.downtimeBusinessCost,
          withStacktic: currentCosts.downtimeBusinessCost - savings.downtimeSavings,
          savings: savings.downtimeSavings
        },
        {
          name: 'Security Incidents',
          current: currentCosts.securityIncidentCost,
          withStacktic: currentCosts.securityIncidentCost - savings.securitySavings,
          savings: savings.securitySavings
        },
        {
          name: 'Stacktic Platform & Support',
          current: 0,
          withStacktic: stackticCosts.annualCost,
          savings: -stackticCosts.annualCost
        }
      ];

      let html = '';
      categories.forEach(cat => {
        const savings3yr = cat.savings * 3;
        html += `
          <tr>
            <td><strong>${cat.name}</strong></td>
            <td class="comparison-current">${formatCurrency(cat.current)}</td>
            <td class="comparison-stacktic">${formatCurrency(cat.withStacktic)}</td>
            <td class="comparison-savings">${formatCurrency(cat.savings)}</td>
            <td class="comparison-savings">${formatCurrency(savings3yr)}</td>
          </tr>
        `;
      });

      // Total row
      const currentTotal = currentCosts.totalAnnual;
      const stackticTotal = currentTotal - savings.totalAnnualSavings + stackticCosts.annualCost;
      const annualSavings = currentTotal - stackticTotal;
      const savings3yr = annualSavings * 3;

      html += `
        <tr style="border-top: 3px solid var(--gray-300); font-weight: 700; background: var(--gray-50);">
          <td><strong>TOTAL</strong></td>
          <td class="comparison-current">${formatCurrency(currentTotal)}</td>
          <td class="comparison-stacktic">${formatCurrency(stackticTotal)}</td>
          <td class="comparison-savings">${formatCurrency(annualSavings)}</td>
          <td class="comparison-savings">${formatCurrency(savings3yr)}</td>
        </tr>
      `;

      tbody.innerHTML = html;
    }

    function updateTimeline(roi, savings, stackticCosts) {
      // Monthly timeline view
      const timelineView = document.getElementById('timelineView');
      if (!timelineView) {
        console.warn('timelineView not found');
        return;
      }
      let html = '<div style="padding: 20px;">';

      const monthlySavings = savings.totalAnnualSavings / 12;
      const monthlyCost = stackticCosts.annualCost / 12;
      const monthlyNet = monthlySavings - monthlyCost;

      let cumulative = -stackticCosts.implementationCost;

      for (let month = 1; month <= 36; month++) {
        cumulative += monthlyNet;
        const progress = Math.max(0, Math.min(100, (cumulative / roi.total3YearROI) * 100));
        const isPositive = cumulative >= 0;

        html += `
          <div class="timeline-row">
            <div class="timeline-period">Month ${month}</div>
            <div class="timeline-bar">
              <div class="timeline-fill" style="width: ${progress}%; background: ${isPositive ? 'linear-gradient(90deg, var(--success), #16a34a)' : 'linear-gradient(90deg, var(--danger), #dc2626)'};">
                ${formatCurrency(cumulative)}
              </div>
            </div>
          </div>
        `;
      }

      html += '</div>';
      timelineView.innerHTML = html;

      // Quarterly table
      const quarterlyBody = document.getElementById('quarterlyTableBody');
      if (!quarterlyBody) {
        console.warn('quarterlyTableBody not found');
        return;
      }
      let qHtml = '';
      let qCumulative = -stackticCosts.implementationCost;

      for (let q = 1; q <= 12; q++) {
        const qSavings = (savings.totalAnnualSavings / 4);
        const qCost = (stackticCosts.annualCost / 4) + (q === 1 ? stackticCosts.implementationCost : 0);
        const qNet = qSavings - qCost;
        qCumulative += qNet;

        qHtml += `
          <tr>
            <td><strong>Q${q}</strong></td>
            <td class="comparison-current">${formatCurrency(qCost)}</td>
            <td class="comparison-savings">${formatCurrency(qSavings)}</td>
            <td class="${qNet >= 0 ? 'comparison-savings' : 'comparison-current'}">${formatCurrency(qNet)}</td>
            <td class="${qCumulative >= 0 ? 'comparison-savings' : 'comparison-current'}">${formatCurrency(qCumulative)}</td>
          </tr>
        `;
      }
      quarterlyBody.innerHTML = qHtml;

      // Yearly table
      const yearlyBody = document.getElementById('yearlyTableBody');
      if (!yearlyBody) {
        console.warn('yearlyTableBody not found');
        return;
      }
      let yHtml = '';

      const years = [
        { savings: savings.totalAnnualSavings, cost: stackticCosts.annualCost + stackticCosts.implementationCost, net: roi.year1NetSavings },
        { savings: savings.totalAnnualSavings, cost: stackticCosts.annualCost, net: roi.year2NetSavings },
        { savings: savings.totalAnnualSavings, cost: stackticCosts.annualCost, net: roi.year3NetSavings }
      ];

      years.forEach((year, i) => {
        const roiPct = year.cost > 0 ? Math.round((year.net / year.cost) * 100) : 0;
        yHtml += `
          <tr>
            <td><strong>Year ${i + 1}</strong></td>
            <td class="comparison-savings">${formatCurrency(year.savings)}</td>
            <td class="comparison-current">${formatCurrency(year.cost)}</td>
            <td class="comparison-savings">${formatCurrency(year.net)}</td>
            <td><strong>${roiPct}%</strong></td>
          </tr>
        `;
      });

      yearlyBody.innerHTML = yHtml;
    }

    function updateCharts() {
      // Destroy existing charts
      Object.values(charts).forEach(chart => {
        if (chart) chart.destroy();
      });

      const inputs = getInputValues();
      const currentCosts = calculateCurrentCosts(inputs);
      const stackticCosts = calculateStackticCosts(inputs);
      const savings = calculateSavings(currentCosts, stackticCosts, inputs);
      const roi = calculateROI(savings, stackticCosts);

      // Cost Comparison Chart
      const costCtx = document.getElementById('costComparisonChart')?.getContext('2d');
      if (costCtx) {
        charts.costComparison = new Chart(costCtx, {
          type: 'bar',
          data: {
            labels: ['Year 1', 'Year 2', 'Year 3'],
            datasets: [
              {
                label: 'Current State',
                data: [currentCosts.totalAnnual, currentCosts.totalAnnual, currentCosts.totalAnnual],
                backgroundColor: 'rgba(239, 68, 68, 0.7)',
                borderColor: 'rgb(239, 68, 68)',
                borderWidth: 2
              },
              {
                label: 'With Stacktic',
                data: [
                  currentCosts.totalAnnual - savings.totalAnnualSavings + stackticCosts.annualCost + stackticCosts.implementationCost,
                  currentCosts.totalAnnual - savings.totalAnnualSavings + stackticCosts.annualCost,
                  currentCosts.totalAnnual - savings.totalAnnualSavings + stackticCosts.annualCost
                ],
                backgroundColor: 'rgba(34, 197, 94, 0.7)',
                borderColor: 'rgb(34, 197, 94)',
                borderWidth: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'top' },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return context.dataset.label + ': ' + formatCurrency(context.parsed.y);
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return formatCurrency(value);
                  }
                }
              }
            }
          }
        });
      }

      // ROI Timeline Chart
      const roiCtx = document.getElementById('roiTimelineChart')?.getContext('2d');
      if (roiCtx) {
        charts.roiTimeline = new Chart(roiCtx, {
          type: 'line',
          data: {
            labels: ['Start', 'Year 1', 'Year 2', 'Year 3'],
            datasets: [{
              label: 'Cumulative ROI',
              data: [
                -stackticCosts.implementationCost,
                roi.year1NetSavings,
                roi.year1NetSavings + roi.year2NetSavings,
                roi.total3YearROI
              ],
              borderColor: 'rgb(102, 126, 234)',
              backgroundColor: 'rgba(102, 126, 234, 0.1)',
              tension: 0.4,
              fill: true,
              borderWidth: 3
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return 'Cumulative ROI: ' + formatCurrency(context.parsed.y);
                  }
                }
              }
            },
            scales: {
              y: {
                ticks: {
                  callback: function(value) {
                    return formatCurrency(value);
                  }
                }
              }
            }
          }
        });
      }

      // Savings Breakdown Chart
      const savingsCtx = document.getElementById('savingsBreakdownChart')?.getContext('2d');
      if (savingsCtx) {
        charts.savingsBreakdown = new Chart(savingsCtx, {
          type: 'doughnut',
          data: {
            labels: ['Ops Labor', 'Deployment', 'Incident Response', 'Database (Managed→K8s)', 'Downtime', 'Security'],
            datasets: [{
              data: [
                savings.opsLaborSavings,
                savings.deploymentSavings,
                savings.incidentResponseSavings,
                savings.databaseSavings,
                savings.downtimeSavings,
                savings.securitySavings
              ],
              backgroundColor: [
                'rgba(102, 126, 234, 0.8)',
                'rgba(34, 197, 94, 0.8)',
                'rgba(245, 158, 11, 0.8)',
                'rgba(139, 92, 246, 0.8)',
                'rgba(236, 72, 153, 0.8)',
                'rgba(59, 130, 246, 0.8)'
              ],
              borderWidth: 2,
              borderColor: 'white'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'right' },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return context.label + ': ' + formatCurrency(context.parsed);
                  }
                }
              }
            }
          }
        });
      }

      // Time Savings Chart
      const timeCtx = document.getElementById('timeSavingsChart')?.getContext('2d');
      if (timeCtx) {
        const totalHours = parseInt(document.getElementById('grandTotalHours')?.textContent) || 0;
        const savedHours = parseInt(document.getElementById('grandSavedHours')?.textContent) || 0;

        charts.timeSavings = new Chart(timeCtx, {
          type: 'bar',
          data: {
            labels: ['Infrastructure', 'Database', 'Deployment', 'Security', 'Monitoring', 'Day-2 Ops', 'API', 'Data', 'Docs'],
            datasets: [{
              label: 'Hours Saved',
              data: [1200, 900, 1800, 1500, 800, 1100, 600, 700, 400], // TODO: calculate from tasks
              backgroundColor: 'rgba(34, 197, 94, 0.7)',
              borderColor: 'rgb(34, 197, 94)',
              borderWidth: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return value + ' hrs';
                  }
                }
              }
            }
          }
        });
      }

      // Risk Reduction Chart
      const riskCtx = document.getElementById('riskReductionChart')?.getContext('2d');
      if (riskCtx) {
        charts.riskReduction = new Chart(riskCtx, {
          type: 'radar',
          data: {
            labels: ['Downtime', 'Security Incidents', 'Deployment Failures', 'Compliance Violations', 'Configuration Drift'],
            datasets: [
              {
                label: 'Current Risk',
                data: [100, 100, 100, 100, 100],
                borderColor: 'rgb(239, 68, 68)',
                backgroundColor: 'rgba(239, 68, 68, 0.2)',
                borderWidth: 2
              },
              {
                label: 'With Stacktic',
                data: [
                  (1 - inputs.downtimeReduction) * 100,
                  (1 - inputs.incidentReduction) * 100,
                  15,
                  10,
                  5
                ],
                borderColor: 'rgb(34, 197, 94)',
                backgroundColor: 'rgba(34, 197, 94, 0.2)',
                borderWidth: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              r: {
                beginAtZero: true,
                max: 100,
                ticks: {
                  callback: function(value) {
                    return value + '%';
                  }
                }
              }
            }
          }
        });
      }
    }

    // ==========================================
    // UTILITY FUNCTIONS
    // ==========================================

    /**
     * Format a numeric value as USD currency
     * Uses Intl.NumberFormat for proper locale-aware formatting
     *
     * @param {number} amount - The amount to format
     * @returns {string} Formatted currency string (e.g., "$1,234,567")
     *
     * Examples:
     *   formatCurrency(1234567) => "$1,234,567"
     *   formatCurrency(0) => "$0"
     *   formatCurrency(-500) => "-$500"
     */
    function formatCurrency(amount) {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
      }).format(amount);
    }

    /**
     * Format a numeric value with thousand separators
     *
     * @param {number} num - The number to format
     * @returns {string} Formatted number string (e.g., "1,234,567")
     *
     * Examples:
     *   formatNumber(1234567) => "1,234,567"
     *   formatNumber(42) => "42"
     */
    function formatNumber(num) {
      return new Intl.NumberFormat('en-US').format(num);
    }

    function updateRangeValue(elem, targetId) {
      const value = elem.value;
      const target = document.getElementById(targetId);
      if (target) {
        const suffix = elem.parentElement.querySelector('.range-value')?.textContent.includes('%') ? '%' :
                      elem.parentElement.querySelector('.range-value')?.textContent.includes('x') ? 'x' : '';
        target.textContent = value + suffix;
      }
    }

    function toggleBreakdown(header) {
      const content = header.nextElementSibling;
      const icon = header.querySelector('.collapsible-icon');

      content.classList.toggle('expanded');
      icon.classList.toggle('expanded');
    }

    function showLoading() {
      document.getElementById('loadingOverlay').classList.add('show');
    }

    function hideLoading() {
      document.getElementById('loadingOverlay').classList.remove('show');
    }

    function resetToDefaults() {
      if (confirm('Reset all inputs to default values?')) {
        document.getElementById('companySize').value = 'medium';
        document.getElementById('numStacks').value = '5';
        document.getElementById('teamSize').value = '25';
        document.getElementById('engineerCost').value = '150000';
        document.getElementById('numDatabases').value = '100000';
        document.getElementById('managedPercent').value = '70';
        document.getElementById('downtimeCost').value = '25000';
        document.getElementById('incidentCost').value = '50000';
        document.getElementById('opsTimePercent').value = '60';
        document.getElementById('deploymentsPerMonth').value = '20';
        document.getElementById('deploymentHours').value = '160';
        document.getElementById('securityIncidents').value = '12';
        document.getElementById('downtimeHours').value = '24';
        document.getElementById('failedDeployments').value = '15';

        updateRangeValue(document.getElementById('opsTimePercent'), 'opsTimeValue');
        updateRangeValue(document.getElementById('failedDeployments'), 'failedDeploymentsValue');
        updateRangeValue(document.getElementById('managedPercent'), 'managedPercentValue');

        setScenario('conservative');
        updateCalculations();
      }
    }

    // Export functions (placeholders)
    function exportTasksToCSV() {
      alert('CSV export functionality coming soon');
    }

    function generatePDF() {
      window.print();
    }

    function generateExcel() {
      alert('Excel export functionality coming soon');
    }

    function emailReport() {
      alert('Email functionality coming soon');
    }
  </script>
